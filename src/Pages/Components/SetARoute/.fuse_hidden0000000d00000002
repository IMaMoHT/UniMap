.SetARoute {
  display: flex;
  padding: 10px 0;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 12px;
  align-self: stretch;
}

.SetARoute-title {
  color: #6B6B6B;
  font-family: Inter;
  font-size: 14px;
  font-style: normal;
  font-weight: 400;
  line-height: 20px;
}

.route-controls {
  display: flex;
  gap: 8px;
  align-items: center;
  width: 100%;
}

.clear-routes-btn {
  padding: 10px 16px;
  background: transparent;
  border: 1px solid #6B6B6B;
  border-radius: 100px;
  color: #6B6B6B;
  font-size: 14px;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  flex: 1;
}

.clear-routes-btn:hover {
  background: #39A39B;
  border-color: #39A39B;
  color: #fff;
} 

.route-hint {
  border: 1px solid rgba(155, 239, 139, 0.45);
  background: rgba(155, 239, 139, 0.12);
  border-radius: 12px;
  padding: 10px 12px;
  color: #4a4a4a;
  font-size: 12px;
  line-height: 18px;
  width: 100%;
  box-sizing: border-box;
}

.route-hint__title {
  display: block;
  font-weight: 600;
  color: #4f9e4a;
  margin-bottom: 4px;
}

.route-hint__text {
  display: block;
}

.route-hint__text strong {
  color: #4f9e4a;
  font-weight: 600;
}

.route-hint__switch {
  margin-top: 10px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border: none;
  border-radius: 100px;
  background: #39a39b;
  color: #fff;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.18s ease;
}

.route-hint__switch:hover {
  background: #2d8a84;
}
