{
  // Конфіг для деплою на Cloudflare Workers (статичний сайт без серверного коду).
  //
  // UniMap — це чистий фронтенд: увесь вміст лежить у dist/ після `npm run build`.
  // Тому поле "main" (код воркера) не потрібне — Cloudflare просто роздає файли.
  "name": "unimap",
  "compatibility_date": "2026-08-30",

  "assets": {
    // Папка, яку збирає Vite
    "directory": "./dist",

    // SPA-режим: будь-яка адреса, що не збігається з файлом, віддає index.html
    // зі статусом 200. Саме це потрібно, щоб працювали посилання з QR-кодів
    // виду /?start=55 і майбутні внутрішні маршрути.
    "not_found_handling": "single-page-application"
  }
}
